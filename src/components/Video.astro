---
interface Props {
	src: string;
	/** Safari HEVC-with-alpha (.mov) — pair with a VP9 WebM `src` for transparent video. */
	srcMov?: string;
	title: string;
	loop?: boolean;
	poster?: string;
	class?: string;
	subtitleVideo?: string;
	/** Intrinsic video size — reserves layout before metadata loads (CLS). */
	width?: number;
	height?: number;
}

const {
	src,
	srcMov,
	title,
	loop = false,
	poster,
	class: className,
	subtitleVideo,
	width = 16,
	height = 9,
} = Astro.props;

const mediaRatio = width / height;
const orientation = mediaRatio < 1 ? 'portrait' : 'landscape';
const isWebm = src.endsWith('.webm');
---

<>
	<div
		class:list={['project-video', className]}
		data-project-video
		data-orientation={orientation}
		style={`--media-ratio: ${mediaRatio}`}
	>
		<video
			poster={poster}
			title={title}
			muted
			playsinline
			preload="metadata"
			loop={loop || undefined}
			width={width}
			height={height}
			src={srcMov ? undefined : src}
			data-has-alpha={srcMov ? 'true' : undefined}
		>
			{
				srcMov && (
					<>
						<source src={srcMov} type="video/quicktime" />
						<source src={src} type={isWebm ? 'video/webm' : 'video/mp4'} />
					</>
				)
			}
		</video>
	</div>
	{subtitleVideo && <p class="project-video-subtitle">{subtitleVideo}</p>}
</>

<style is:global lang="scss">
	@use '../styles/components/project-video.scss';
</style>
