---
interface Props {
	src: string;
	title: string;
	loop?: boolean;
	poster?: string;
	class?: string;
	subtitleVideo?: string;
	/** Intrinsic video size — reserves layout before metadata loads (CLS). */
	width?: number;
	height?: number;
}

const {
	src,
	title,
	loop = false,
	poster,
	class: className,
	subtitleVideo,
	width = 16,
	height = 9,
} = Astro.props;

const mediaRatio = width / height;
const orientation = mediaRatio < 1 ? 'portrait' : 'landscape';
---

<>
	<div
		class:list={['project-video', className]}
		data-project-video
		data-orientation={orientation}
		style={`--media-ratio: ${mediaRatio}`}
	>
		<video
			src={src}
			poster={poster}
			title={title}
			muted
			playsinline
			preload="metadata"
			loop={loop || undefined}
			width={width}
			height={height}
		></video>
	</div>
	{subtitleVideo && <p class="project-video-subtitle">{subtitleVideo}</p>}
</>

<style is:global lang="scss">
	@use '../styles/components/project-video.scss';
</style>
