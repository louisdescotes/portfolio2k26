---
import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Format = 'default' | 'portrait';

interface Props {
	src: ImageMetadata;
	alt: string;
	format?: Format;
	class?: string;
}

const { src, alt, format = 'default', class: className } = Astro.props;
---

<AstroImage
	src={src}
	alt={alt}
	class:list={[format === 'portrait' && 'is-portrait', className]}
/>
